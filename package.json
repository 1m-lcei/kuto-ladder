{
  "name": "kuto-ladder",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "precompute": "bun scripts/precompute.ts",
    "fix": "biome check --write .",
    "check": "biome check .",
    "test": "bun test",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:edge": "playwright test --project=msedge",
    "test:performance": "playwright test --project=performance",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "verify": "bun run check && bun run typecheck && bun test && bun run build && bun run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "playwright": "1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
