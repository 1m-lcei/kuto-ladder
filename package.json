{
  "name": "kuto-ladder",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist",
